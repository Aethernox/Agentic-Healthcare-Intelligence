# ─── MedMap Backend Configuration ───────────────────────────────────────────
# Copy this file to .env and fill in your values

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Required for LLM-based extraction (pipelines/ingest.py --llm-extract)
ANTHROPIC_API_KEY=sk-ant-...

# Required for web verification of low-trust hospitals
TAVILY_API_KEY=tvly-...

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (zero setup, good for dev/hackathon)
DATABASE_URL=sqlite:///./medmap.db

# Production: PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/medmap

# ── Databricks (optional — for Mosaic AI vector search) ──────────────────────
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...
# VECTOR_SEARCH_ENDPOINT=your-endpoint-name
# VECTOR_SEARCH_INDEX=medmap.hospitals.embeddings

# ── MLflow (optional) ─────────────────────────────────────────────────────────
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT_NAME=/medmap/agent-runs

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# Trust score thresholds
TRUST_HIGH_THRESHOLD=75
TRUST_MEDIUM_THRESHOLD=40
TAVILY_TRIGGER_THRESHOLD=50
