# ── AI / LLM ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# ── Databricks ────────────────────────────────────────

DATABRICKS_HOST=host-url
DATABRICKS_TOKEN=auth-token
VECTOR_SEARCH_ENDPOINT=medmap-endpoint
VECTOR_SEARCH_INDEX=medmap.hospitals.embeddings

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://medmap:medmap@localhost:5432/medmap
REDIS_URL=redis://localhost:6379

# ── MLflow ────────────────────────────────────────────
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/medmap/agent-runs

# ── App ────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Frontend (Vite) ────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
VITE_USE_MOCK=true
